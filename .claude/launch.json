{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "main:app", "--port", "8000"],
      "cwd": "backend",
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "frontend",
      "port": 5173
    },
    {
      "name": "backend-alt",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "main:app", "--port", "8001"],
      "cwd": "backend",
      "port": 8001
    },
    {
      "name": "frontend-alt",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "--port", "5174"],
      "cwd": "frontend",
      "env": { "VITE_API_BASE": "http://localhost:8001" },
      "port": 5174
    }
  ]
}
